<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <artifactId>chromia-cli-tools-parent</artifactId>
        <groupId>com.chromia.cli.tools</groupId>
        <version>${revision}</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>

    <packaging>pom</packaging>
    <name>Chromia cli coverage report aggregate</name>
    <artifactId>coverage-report-aggregate</artifactId>
    <description>A module that JaCoCo uses to aggregate code coverage reports from all modules</description>

    <properties>
        <codeClimate.report>${project.parent.build.directory}/code-quality-reports/code-climate.json</codeClimate.report>
    </properties>

    <dependencies>
        <!-- Postchain modules to aggregate coverage reports -->
        <dependency>
            <groupId>com.chromia.cli.tools</groupId>
            <artifactId>chromia-build-tools</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.chromia.cli.tools</groupId>
            <artifactId>chromia-cli-tools</artifactId>
            <version>${project.version}</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-install-plugin</artifactId>
                <configuration>
                    <skip>true</skip>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-deploy-plugin</artifactId>
                <configuration>
                    <skip>true</skip>
                </configuration>
            </plugin>
            <plugin>
                <groupId>se.bjurr.violations</groupId>
                <artifactId>violations-maven-plugin</artifactId>
                <version>2.2.0</version>
                <executions>
                    <execution>
                        <phase>validate</phase>
                        <goals>
                            <goal>violations</goal>
                        </goals>
                        <configuration>
                            <printViolations>false</printViolations>
                            <codeClimateFile>${codeClimate.report}</codeClimateFile>
                            <violations>
                                <violation>
                                    <parser>CHECKSTYLE</parser>
                                    <reporter>Detekt</reporter>
                                    <folder>${project.parent.build.directory}</folder>
                                    <pattern>.*/detekt-report\.xml$</pattern>
                                </violation>
                            </violations>
                        </configuration>
                        <inherited>false</inherited>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>coverage</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.jacoco</groupId>
                        <artifactId>jacoco-maven-plugin</artifactId>
                        <version>0.8.10</version>
                        <executions>
                            <execution>
                                <id>jacoco-site-aggregate</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>report-aggregate</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
